{
  "name": "3waNetflix",
  "action": {},
  "manifest_version": 3,
  "author": "羽山秋人 (https://3wa.tw)",
  "version": "3.6.3",
  "description": "讓 netflix 的字幕稍微調大一點",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {},
  "host_permissions": [
    "https://*.netflix.com/*"
  ],
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "content_scripts": [
    {
      "js": [
        "libs/jquery-3.7.1.min.js",
        "content.js"
      ],
      "matches": [
        "https://www.netflix.com/*"
      ]
    }
  ]
}
